# このファイルをコピーして .env.local を作り、実際の値を入れる。
# .env.local は git に載せない（.gitignore 済み）。値は絶対に公開しない。

# --- Supabase（次のステップで作成するアカウントから取得）---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- データベース接続（Supabase の Connection string）---
DATABASE_URL=

# --- Stripe（後のステップ。まずテストキーでよい）---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- アプリURL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- メール送信（Resend）。未設定なら送信スキップ ---
RESEND_API_KEY=
EMAIL_FROM=FOOD JAPAN NAKAMA <onboarding@resend.dev>

# --- 掲載文の下書き支援（OpenAI）。未設定ならフォームにボタンを出さない ---
OPENAI_API_KEY=
