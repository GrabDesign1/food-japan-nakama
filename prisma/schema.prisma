// Food Japan Connect — データベース設計
// 一次資料: docs/HANDOVER.md 第4章。未確定事項は docs/DECISIONS.md。
// 今回のマイグレーション範囲: 認証・テナント・会員の土台（実装順1〜2）。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 では接続URLは prisma.config.ts（CLI/マイグレーション用）と
  // PrismaClient のアダプタ（実行時）で指定する。
}

// ── 区分（enum）─────────────────────────────

// 担当者の立場（会員種別とは別軸。users に持つ）
enum UserStance {
  BUYER    // バイヤー
  CHEF     // シェフ・料理人
  PRODUCER // 生産者
  GENERAL  // 一般
}

// 権限ロール（HANDOVER 第7章）
enum UserRole {
  TENANT_ADMIN
  ADMIN
  REVIEWER
  VIEWER
  MEMBER
}

// ユーザーの状態
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// 会員（法人）の審査状態（HANDOVER 4-1）
enum MemberStatus {
  DRAFT             // 下書き
  PENDING           // 審査中
  APPROVED          // 承認
  AWAITING_PAYMENT  // 課金してもらう（承認・要課金）
  SUSPENDED         // 停止
  REJECTED          // 非承認（情報記載を促す）
}

// 課金状態（当面は自社DBで管理。タスク9でStripe連携して自動更新）
enum PaymentStatus {
  FREE    // 無料
  UNPAID  // 未決済
  PAID    // 課金中
}

// 持ち寄り台帳の向き
enum OfferingDirection {
  GIVE // 譲りたい・出せる（提供）
  WANT // あったらいいな・探している（募集）
}

// ── テーブル ───────────────────────────────

/// テナント（実行委員会。将来の他イベント展開を想定）
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users   User[]
  members Member[]

  @@map("tenants")
}

/// ログインユーザー（個人）。Supabase Auth の user と authId で紐づく
model User {
  id       String     @id @default(cuid())
  tenantId String     @map("tenant_id")
  authId   String?    @unique @map("auth_id") // Supabase Auth の UUID
  email    String
  name     String
  stance   UserStance @default(GENERAL)
  role     UserRole   @default(MEMBER)
  memberId String?    @map("member_id")
  status   UserStatus @default(INVITED)

  /// 案内メール（案件・イベント・共創支援等）への同意日時（特定電子メール法の同意記録。null=未同意）
  marketingOptInAt DateTime? @map("marketing_opt_in_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// 会員法人・団体（HANDOVER 4-1）
model Member {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String       // 事業者名
  avatarUrl   String?      @map("avatar_url") // アイコン（プロフィール画像）
  companyLogoUrl String?   @map("company_logo_url") // 会社ロゴ
  brandLogoUrl   String?   @map("brand_logo_url")   // ブランドロゴ
  contactName String?      @map("contact_name") // 担当者名（姓名）
  contactKana String?      @map("contact_kana") // 担当者名（ひらがな）
  categoryL1  String       @map("category_l1") // 大分類（HANDOVER 第5章）
  categoryL2  String?      @map("category_l2") // 細分類
  prefecture  String?
  area        String?      // 地域7区分（検索用。将来 prefecture から自動導出）
  city        String?      // 市区町村
  postalCode  String?      @map("postal_code") // 郵便番号
  address     String?      // 本店所在地（番地・建物）
  website     String?
  founded     String?
  size        String?
  description String?

  imageUrls String[] @map("image_urls") // サムネイル画像URL（最大4枚。Supabase Storage）

  hasLicense  Boolean @default(false) @map("has_license") // 許認可あり/なし
  licenseName String? @map("license_name")                // 許認可名

  /// 適格請求書発行事業者の登録番号（T+13桁）。請求書の作成に使う。未登録（免税事業者）は空のまま
  invoiceRegNo String? @map("invoice_reg_no")
  /// 請求書に印字する振込先（銀行名・支店・種別・番号・名義を1行で）。NAKAMAは代金を預からない
  bankAccount  String? @map("bank_account")

  productItems  String? @map("product_items")  // 生産品目名（例：リーフレタス、ネギ、ブロッコリー）
  productVolume String? @map("product_volume") // 生産量（例：露地2ha／各品目50ケース/週）

  // 事業の中身（自由記述。2-1 の項目出し分けは後日）
  featureText   String? @map("feature_text")
  equipmentText String? @map("equipment_text")
  salesAreaText String? @map("sales_area_text")
  logisticsText String? @map("logistics_text")
  foodlossText  String? @map("foodloss_text")
  challengeText String? @map("challenge_text")

  collabStyle String? @map("collab_style") // 組みたい相手
  startTiming String? @map("start_timing")

  completionRate Int           @default(0) @map("completion_rate") // 記入率
  level          Int           @default(0)
  status         MemberStatus  @default(DRAFT)
  paymentStatus  PaymentStatus @default(FREE) @map("payment_status")
  approvedAt     DateTime?     @map("approved_at")
  approvedBy     String?       @map("approved_by")

  // Stripe連携（解約・削除時にサブスクを確実に特定するため保存する）
  stripeCustomerId     String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")

  /// 退会申請（会員が自分で申し出た日時と理由。実削除は事務局が行う＝誤操作と課金の取り残しを防ぐ）
  withdrawalRequestedAt DateTime? @map("withdrawal_requested_at")
  withdrawalReason      String?   @map("withdrawal_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  offerings Offering[]
  favorites Favorite[]

  @@index([tenantId])
  @@index([status])
  @@index([stripeCustomerId])
  @@map("members")
}

/// Stripe Webhookの冪等化（同じイベントIDを二度処理しない）
model StripeEvent {
  id        String   @id // Stripeのevent.id（evt_...）
  type      String
  /// 副作用の適用が完了した時刻。null=受信済みだが未処理（タイムアウト・強制終了で取りこぼした分）。
  /// 未処理のまま再送が来たら処理し直す。
  processedAt DateTime? @map("processed_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

/// 監査ログ（事務局の重要操作を追記専用で記録。HANDOVER 189/279・規約17条）
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  actorUserId String   @map("actor_user_id")
  actorEmail  String?  @map("actor_email")
  action      String   // 例: member.delete / member.mark_paid / admin.create / project.approve
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  detail      String?  // 補足（理由・変更前の値など）
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// お知らせ（事務局が投稿し、会員ダッシュボードに表示）
model Announcement {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  title     String
  body      String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("announcements")
}

/// バナー（事務局が登録し、会員ダッシュボードに表示）
model Banner {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  title     String? // 管理用の名前（任意）
  imageUrl  String   @map("image_url") // バナー画像URL（Supabase Storage）
  linkUrl   String?  @map("link_url") // クリック時のリンク先
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("banners")
}

/// 個別相談（共創プロデュース／クラウドファンディング支援）の問い合わせ。
model Consultation {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  refNo          String   @unique @map("ref_no") // 受付番号
  serviceType    String   @map("service_type") // produce / crowdfunding / unsure
  company        String
  name           String
  email          String
  phone          String?
  area           String? // 所在地／対象地域
  industry       String?
  productSummary String   @map("product_summary") // 商品・地域資源・技術の概要
  challenge      String // 解決したい課題
  desiredOutcome String?  @map("desired_outcome") // 希望する成果
  desiredTiming  String?  @map("desired_timing") // 希望開始時期
  budget         String? // 想定予算（選択式）
  status         String   @default("new") // new / reviewing / contacted / proposed / won / lost
  ip             String?  // 送信元IP（レート制限・濫用対策用）
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([ip, createdAt])
  @@map("consultations")
}

/// 事務局がキュレーションする外部の食の記事（PR TIMES / note / 新聞など）。公開トップに掲載。
model CuratedArticle {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  title     String
  url       String // 外部記事URL
  source    String // 出典（PR TIMES / note / 日本経済新聞 など）
  imageUrl  String?  @map("image_url") // サムネイル画像URL（任意）
  excerpt   String? // 概要（任意）
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  publishStart DateTime? @map("publish_start") // 掲載開始（未設定なら即時）
  publishEnd   DateTime? @map("publish_end")   // 掲載終了（未設定なら無期限）
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("curated_articles")
}

/// 共創プロジェクト掲載（HANDOVER 4-1 / 画面7。2026-08-10 共創プロジェクト改修で拡張）
model Project {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  memberId    String    @map("member_id")
  title       String
  body        String?
  fromRole    String? @map("from_role") // あなたの立場（会員種別 大分類）
  toRole      String? @map("to_role") // 相談したい相手（会員種別 大分類）
  area        String? // 対象地域（都道府県・任意）
  budget         String? // 予算感（例：10〜30万円 / 応相談）
  imageUrls      String[] @map("image_urls")
  bodyImageUrl   String?  @map("body_image_url") // 本文セクションの画像
  tags        String[]
  status      String    @default("draft") // draft / pending / published / closed
  publishedAt DateTime? @map("published_at")
  viewCount   Int       @default(0) @map("view_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // ── 目的と基本情報（全てnullable＝旧データ互換。選択肢は src/lib/project-taxonomy.ts）──
  purposeMain  String?   @map("purpose_main") // 主目的
  purposeSub   String[]  @map("purpose_sub") // 関連目的（複数）
  oneLiner     String?   @map("one_liner") // 一言で表す目的
  deadline     DateTime? // 募集期限
  targetTiming String?   @map("target_timing") // 目標時期
  leaderName   String?   @map("leader_name") // プロジェクト責任者

  // ── 背景と実現したいこと（質問形式）──
  challengeIssue String? @map("challenge_issue") // どのような課題がありますか
  challengeWhy   String? @map("challenge_why") // なぜ解決したいのですか
  challengeWho   String? @map("challenge_who") // 誰にどのような影響がありますか
  coCreationGoal String? @map("co_creation_goal") // 共創によって何を実現したいですか
  futureVision   String? @map("future_vision") // 事業化した先に目指す状態

  // ── 現在地 ──
  stage            String? // 現在の段階（idea/research/prototype/pilot/prelaunch/running）
  stageDone        String? @map("stage_done") // これまでに取り組んだこと
  stageLearned     String? @map("stage_learned") // 分かっていること・検証できたこと
  stageIssues      String? @map("stage_issues") // 未解決の論点
  stageSchedule    String? @map("stage_schedule") // 目標スケジュール
  existingPartners String? @map("existing_partners") // 既存の参加者・協力者（公開できる範囲で記載）

  // ── 条件・イベント連携 ──
  period       String? // 実施期間
  place        String? // 実施場所
  rewardPolicy String?  @map("reward_policy") // 報酬・費用負担・売上分配（decided/negotiable/none/tbd。未定と無償は別値）
  contractNote String?  @map("contract_note") // 契約・秘密保持の必要性
  eventFlags   String[] @map("event_flags") // FJS連携（fjs_origin/miyazaki/nagoya/business_meeting/tasting/tour）
  supportRequested Boolean @default(false) @map("support_requested") // 事務局伴走を希望
  supportOfficial  Boolean @default(false) @map("support_official") // 「事務局伴走中」表示（事務局のみ設定可）
  reviewNote       String? @map("review_note") // 事務局の差し戻し理由（再申請で消去・掲載者の編集画面に表示）

  applications ProjectApplication[]
  roles        ProjectRole[]
  resources    ProjectResource[]
  activities   ProjectActivity[]

  @@index([memberId])
  @@index([status])
  @@map("projects")
}

/// 募集する相手・役割（共創プロジェクトの子。役割単位で登録）
model ProjectRole {
  id          String  @id @default(cuid())
  projectId   String  @map("project_id")
  name        String // 役割名（例：加工パートナー）
  request     String? // 具体的にお願いしたいこと
  requirement String? // 必要な経験・条件
  headcount   String? // 募集数（自由記述）
  period      String? // 参加時期・期間
  reward      String? // 費用・報酬・費用負担
  isPublic    Boolean @default(true) @map("is_public")
  sortOrder   Int     @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_roles")
}

/// 主催者が提供できる資源（共創プロジェクトの子）
model ProjectResource {
  id          String  @id @default(cuid())
  projectId   String  @map("project_id")
  kind        String // 分類（material/tech/facility/channel/people/data/network/pr/fund/other）
  description String? // 説明
  condition   String? // 提供条件
  sortOrder   Int     @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_resources")
}

/// 共創プロジェクトへの応募（興味表明）＋相手ごとの進捗管理
model ProjectApplication {
  id                String   @id @default(cuid())
  projectId         String   @map("project_id")
  applicantMemberId String   @map("applicant_member_id")
  message           String? // 旧・自由記述（互換のため残す）
  status            String   @default("applied") // applied / accepted / declined
  createdAt         DateTime @default(now()) @map("created_at")

  // ── 興味表明の内容（2026-08-10追加）──
  reason      String? // 興味を持った理由
  offer       String? // 自社・本人が提供できるもの
  involvement String? // 希望する関わり方
  meetingWish String? @map("meeting_wish") // 面談希望（yes/undecided/no）
  desiredRole String? @map("desired_role") // 希望する役割（ProjectRoleの名前を自由記述）

  // ── 主催者側の進捗管理（5段階＋保留/見送り/完了）──
  progressStage String    @default("inquiry") @map("progress_stage") // inquiry/meeting/planning/pilot/contract + hold/declined/done
  nextAction    String?   @map("next_action") // 次に行うこと
  nextActionDue DateTime? @map("next_action_due") // 期限
  assignee      String? // 担当者
  nextMeetingAt DateTime? @map("next_meeting_at") // 次回打ち合わせ日時
  ownerMemo     String?   @map("owner_memo") // 最新メモ（主催者のみ・非公開）
  holdReason    String?   @map("hold_reason") // 保留・見送り理由（非公開）
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities ProjectActivity[]

  @@unique([projectId, applicantMemberId])
  @@index([projectId])
  @@map("project_applications")
}

/// 進捗の活動履歴（段階変更・担当変更・見送り等の重要操作を記録）
model ProjectActivity {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  applicationId String?  @map("application_id")
  actorMemberId String   @map("actor_member_id")
  type          String // applied / stage_change / next_action / assignee_change / memo / hold / declined / done / reopened
  detail        String?
  createdAt     DateTime @default(now()) @map("created_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application ProjectApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([applicationId])
  @@map("project_activities")
}

/// 商談（HANDOVER 4-1 / 第6章）。2会員間で1つ。フェーズ0〜5。
model Deal {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  ownerMemberId       String    @map("owner_member_id") // 起点になった側
  counterpartMemberId String    @map("counterpart_member_id")
  threadId            String?   @map("thread_id")
  phase               Int       @default(0) // 0出会う 1初回商談 2条件整理 3試作・PoC 4実証 5成約・商品化
  nextAction          String?   @map("next_action")
  dueDate             DateTime? @map("due_date")
  lastActivityAt      DateTime  @default(now()) @map("last_activity_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([ownerMemberId])
  @@index([counterpartMemberId])
  @@map("deals")
}

/// メッセージスレッド（興味送信から発生。2会員間の会話）
model Thread {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  fromMemberId  String   @map("from_member_id") // 興味を送った側
  toMemberId    String   @map("to_member_id") // 送られた側
  offeringId    String?  @map("offering_id") // きっかけの共創プロジェクト
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  /// 提案・問い合わせ時に相手が申告した金額（税込・円）。掲載者が一覧で比較するための目安で、
  /// 契約・合意ではない（構造化した条件提示は未実装）。
  proposedAmount Int?    @map("proposed_amount")
  /// 見送り（辞退）。どちらの当事者からでも終了でき、一覧では「見送り」として区別する。
  closedAt     DateTime? @map("closed_at")
  closedBy     String?   @map("closed_by")
  closedReason String?   @map("closed_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  messages Message[]
  notes    ProposalNote[]
  offers   ContractOffer[]

  @@index([fromMemberId])
  @@index([toMemberId])
  @@map("threads")
}

/// 秘密保持契約（NDA）の同意記録（2026-08-11）。
/// 雛形を提示し、相手が同意した事実と日時・特記事項を残す。**電子署名ではない**。
/// 雛形の文面は弁護士確認前（`src/lib/nda.ts`）。
model NdaAgreement {
  id            String    @id @default(cuid())
  threadId      String    @unique @map("thread_id")
  offeringId    String?   @map("offering_id")
  /// 同意リクエストを送った側（甲）
  requestedBy   String    @map("requested_by")
  /// 甲・乙の表示名と住所（合意時点の内容を残す）
  partyAName    String    @map("party_a_name")
  partyAAddress String?   @map("party_a_address")
  partyBName    String    @map("party_b_name")
  partyBAddress String?   @map("party_b_address")
  specialTerms  String?   @map("special_terms")
  /// 雛形のバージョン（文面を改定したときに、どの版に同意したか分かるように）
  templateVersion String  @default("2026-08-11") @map("template_version")
  /// requested / agreed / declined
  status        String    @default("requested")
  agreedBy      String?   @map("agreed_by")
  agreedAt      DateTime? @map("agreed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("nda_agreements")
}

/// 違反報告（2026-08-11）。ガイドライン・規約に反する疑いを事務局へ知らせる。
/// 内容の判断と対応は事務局が行い、報告者への個別回答は約束しない（クラウドワークスと同じ方針）。
model ViolationReport {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  /// 報告した会員
  reporterMemberId String @map("reporter_member_id")
  /// 報告の対象（会員・案件・やり取りのいずれか）
  targetType   String   @map("target_type") // member / offering / thread
  targetId     String   @map("target_id")
  /// 違反の種類（VIOLATION_KINDS）
  kind         String
  detail       String?
  /// new / reviewing / handled / dismissed
  status       String   @default("new")
  adminNote    String?  @map("admin_note")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("violation_reports")
}

/// 取引条件の提示と合意の記録（2026-08-11・Phase 1）。
/// **NAKAMAは当事者にならない。お金も預からない**。当事者間の意思表示を記録するだけで、
/// 支払い・納品は当事者間で行う（手数料・仮払いは未実装＝規約と法務の整理が別途必要）。
model ContractOffer {
  id               String    @id @default(cuid())
  threadId         String    @map("thread_id")
  offeringId       String?   @map("offering_id")
  /// 条件を提示した側
  proposerMemberId String    @map("proposer_member_id")
  /// 金額（税込・円）
  amount           Int
  /// 数量・ロットなど
  quantityText     String?   @map("quantity_text")
  /// 納品・完了の予定日
  deliveryDate     DateTime? @map("delivery_date")
  /// 内容・条件の補足
  terms            String?
  /// 消費税率（8＝軽減税率の飲食料品／10＝標準）。請求書の税率区分に使う
  taxRate          Int?      @map("tax_rate")
  /// proposed（提示中）／accepted（合意）／declined（辞退）／superseded（新しい提示に置き換え）
  status           String    @default("proposed")
  respondedAt      DateTime? @map("responded_at")
  respondedBy      String?   @map("responded_by")
  /// 発送・受け渡しが完了した日時（合意後に当事者が記録する）
  completedAt      DateTime? @map("completed_at")
  completedBy      String?   @map("completed_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("contract_offers")
}

/// 掲載者が提案ごとに残す非公開の評価とメモ（相手には見えない）。
/// クラウドワークスの応募者一覧の「お気に入り・メモ（非公開）」に相当（2026-08-11）。
model ProposalNote {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  /// 書いた人（掲載者）。同じスレッドでも人ごとに別のメモを持てる
  memberId  String   @map("member_id")
  /// 5段階の評価（1〜5。未評価は null）
  rating    Int?
  memo      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, memberId])
  @@map("proposal_notes")
}

model Message {
  id             String    @id @default(cuid())
  threadId       String    @map("thread_id")
  senderMemberId String    @map("sender_member_id")
  body           String
  /// 添付1件目（2026-08-11に複数添付へ移行。既存メッセージの表示のため残置。新規は attachments に入る）
  attachmentUrl  String?   @map("attachment_url")
  attachmentName String?   @map("attachment_name")
  /// 添付のバイト数（送信済みメッセージで「◯KB」を表示するため）
  attachmentSize Int?      @map("attachment_size")
  /// このメッセージのきっかけになった案件。引き合い課金の判定はスレッドではなくこの値で行う
  /// （スレッドは会員ペアで1本のため、スレッドの offeringId では後続の問い合わせを判定できない）
  offeringId     String?   @map("offering_id")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  thread      Thread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]

  @@index([threadId])
  @@map("messages")
}

/// メッセージの添付ファイル（複数可・2026-08-11）。
/// 非公開バケット message-attachments の保存パスだけを持ち、配信は /api/attachments が参加者検証をしてから行う。
model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  /// バケット内の保存パス（公開URLは作らない）
  path      String
  name      String
  size      Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// 認証操作の試行記録（ログイン失敗・パスワード再設定のレート制限用。総当たりとメール爆撃を防ぐ）
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String   // signin_failed / password_reset
  email     String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, email, createdAt])
  @@index([kind, ip, createdAt])
  @@map("auth_attempts")
}

/// メッセージテンプレート（会員が作成・保存）
model MessageTemplate {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  name      String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([memberId])
  @@map("message_templates")
}

/// メッセージ下書き（スレッド×会員ごとに1つ）
model MessageDraft {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  memberId  String   @map("member_id")
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([threadId, memberId])
  @@map("message_drafts")
}

/// お気に入り（HANDOVER 4-1）。target は会員(member)またはプロジェクト(offering)
model Favorite {
  id         String   @id @default(cuid())
  memberId   String   @map("member_id") // お気に入りした側の会員
  targetType String   @map("target_type") // "member" | "offering"
  targetId   String   @map("target_id")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, targetType, targetId])
  @@index([memberId])
  @@map("favorites")
}

/// 持ち寄り台帳 ★システムの中心（HANDOVER 4-1）
model Offering {
  id       String            @id @default(cuid())
  memberId String            @map("member_id")
  direction OfferingDirection
  category String // 台帳9分類（src/lib/offering-taxonomy.ts）

  title       String
  description String?

  imageUrls String[] @map("image_urls") // サムネイル・ギャラリー画像
  tags      String[] // タグ（チップ表示）
  points    String? // おすすめポイント（改行区切り）

  descriptionImageUrl String? @map("description_image_url") // 詳細セクションの画像
  pointsImageUrl      String? @map("points_image_url") // おすすめポイントの画像

  // 数量（DECISIONS 2-2 = C案）。食材・原料のみ構造化、それ以外は amountText に自由記述。
  amountValue  Float?  @map("amount_value")
  amountUnit   String? @map("amount_unit")
  amountPeriod String? @map("amount_period")
  amountText   String? @map("amount_text")

  timing   String?
  area     String? // 発送元・受渡地域（自由記述）
  isPublic Boolean @default(true) @map("is_public")

  /// 公開範囲（課金オプション）。public=通常公開 / private=非公開募集 / applicant_only=応募者限定公開。
  /// 有料オプションの適用で変更し、期限切れバッチで public に戻す。
  visibility String @default("public")

  // ── 取引条件（2026-08-10 売りたい改善。全てnullable＝既存データ互換） ──
  priceType           String?   @map("price_type") // fixed / free / negotiable
  priceAmount         Float?    @map("price_amount") // 金額（円）
  priceUnit           String?   @map("price_unit") // 円/kg など
  minOrderText        String?   @map("min_order_text") // 最小取引量（例：20kgから）
  itemCondition       String?   @map("item_condition") // 商品・原料の状態
  storageType         String?   @map("storage_type") // 保存状態
  shelfLifeText       String?   @map("shelf_life_text") // 賞味・取扱期限
  specification       String? // 品質・規格
  supplyFrequency     String?   @map("supply_frequency") // 提供頻度
  deliveryMethods     String[]  @map("delivery_methods") // 受け渡し方法（複数）
  shippingCostBearer  String?   @map("shipping_cost_bearer") // 送料負担
  applicationDeadline DateTime? @map("application_deadline") // 募集期限
  desiredPartner      String?   @map("desired_partner") // 希望する相手・活用用途

  // ── 掲載タイプと物語（2026-08-10 第2次改善。質問に答える形式。全てnullable＝旧案件互換） ──
  listingPurpose   String? @map("listing_purpose") // trade（商品・原料を売りたい）/ challenge（課題を一緒に解決したい）
  tagline          String? // 一言で伝わる特徴（カード・詳細ファーストビューに表示）
  featureDiff      String? @map("feature_diff") // 他の商品と何が違うか（特徴・こだわり）
  backgroundStory  String? @map("background_story") // なぜ作った・売りたいのか（作り手の紹介もここに）
  usageIdeas       String? @map("usage_ideas") // おすすめの売り場・使い方
  challengeCurrent String? @map("challenge_current") // いま何が起きているか（課題解決型）
  challengeScale   String? @map("challenge_scale") // 課題の規模・期限
  challengeTried   String? @map("challenge_tried") // これまで試したこと
  challengeAsk     String? @map("challenge_ask") // 求める協力・提案
  challengeValue   String? @map("challenge_value") // 解決後に生まれる価値
  sampleAvailability String? @map("sample_availability") // サンプル提供：可/応相談/不可
  priceTaxType     String? @map("price_tax_type") // 税込/税別

  // ── 探している（WANT）改善（2026-08-10 買い手指示書。全てnullable＝旧案件互換） ──
  seekingType  String? @map("seeking_type") // specific/proposal/oem/surplus/codev/other（src/lib/offering-taxonomy.ts）
  usageContext String? @map("usage_context") // 使用目的・販売先（何に使うか。売り手の提案判断に最重要）

  // ── NAKAMA確認済み優良案件（課金Phase 1。事務局が確認し記録。有効期間を過ぎると自動で通常扱い） ──
  verifiedLeadAt   DateTime? @map("verified_lead_at") // 確認日時
  verifiedLeadBy   String?   @map("verified_lead_by") // 確認した管理者（email）
  verifiedLeadNote String?   @map("verified_lead_note") // 確認根拠（法人確認・数量・予算・期限・意思など）

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  views OfferingView[]
  requirements OfferingRequirement[]

  @@index([memberId])
  @@index([direction])
  @@index([category])
  @@map("offerings")
}

/// 台帳の閲覧記録（「24時間以内に○人が閲覧」の集計用）
/// 探している（WANT）案件の条件（必須・希望・相談可能の区別つき。2026-08-10 買い手指示書 §6）
model OfferingRequirement {
  id         String @id @default(cuid())
  offeringId String @map("offering_id")
  kind       String // origin/quantity/price/delivery/storage/spec/cert/other（src/lib/offering-taxonomy.ts）
  text       String // 条件の内容（例：常温保存必須）
  level      String // must（必須）/ want（希望）/ negotiable（相談可能）
  sortOrder  Int    @default(0) @map("sort_order")

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@map("offering_requirements")
}

// ── 課金システム（2026-08-10 Phase 1。docs/NAKAMA_課金システム_ClaudeCode実装パッケージ 準拠）──

/// 課金商品マスター（価格をコードへ直書きしない。過去注文はスナップショットで保持）
model BillingProduct {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  code        String  @unique // 不変・一意（例: contact_unlock_standard）
  name        String
  description String?
  billingType String  @map("billing_type") // one_time / quote / grant
  audience    String // sell / seek / both / banner
  effectType  String  @map("effect_type") // featured / top_pr / urgent / matched_notice / private / applicant_only / sns / article / search_support / meeting_support / banner / contact_unlock / contact_credits
  priceAmount Int     @map("price_amount") // 税込・円（JPYはゼロ小数）
  durationDays Int?   @map("duration_days") // 掲載日数 or クレジット有効期限
  unitLimit    Int?   @map("unit_limit") // クレジット件数・通知上限など
  requiresReview Boolean @default(false) @map("requires_review")
  /// NAKAMA会員（月額PAID）の割引率%（販促オプションに適用。0=割引なし）
  memberDiscountPercent Int @default(0) @map("member_discount_percent")
  active    Boolean @default(false) // 非公開で投入し、公開チェック後に有効化
  sortOrder Int     @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems BillingOrderItem[]

  @@index([tenantId, active])
  @@map("billing_products")
}

/// 注文（決済状態）。掲載状態は ListingPromotion に分離する
model BillingOrder {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  memberId String @map("member_id")
  offeringId String? @map("offering_id") // 対象案件（掲載オプションの場合）
  status   String @default("pending_payment") // pending_payment / paid / fulfilled / payment_failed / cancelled / refunded
  subtotalAmount Int    @map("subtotal_amount") // 税込
  discountAmount Int    @default(0) @map("discount_amount") // 会員割引
  totalAmount    Int    @map("total_amount")
  currency       String @default("jpy")
  stripeCheckoutSessionId String? @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @unique @map("stripe_payment_intent_id")
  idempotencyKey          String? @unique @map("idempotency_key")
  paidAt      DateTime? @map("paid_at")
  cancelledAt DateTime? @map("cancelled_at")
  refundedAt  DateTime? @map("refunded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  items BillingOrderItem[]

  @@index([memberId, createdAt])
  @@index([status])
  @@map("billing_orders")
}

/// 注文明細（注文時の商品名・単価・内容をスナップショット保存。価格改定の影響を受けない）
model BillingOrderItem {
  id        String @id @default(cuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  productCode String @map("product_code") // スナップショット
  name        String // スナップショット
  quantity    Int    @default(1)
  unitAmount  Int    @map("unit_amount") // 割引適用後の単価（税込）
  totalAmount Int    @map("total_amount")
  effectType  String @map("effect_type")
  durationDaysSnapshot Int? @map("duration_days_snapshot")

  order   BillingOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product BillingProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("billing_order_items")
}

/// 有料掲載オプションの適用状態（決済状態と分離。表示クエリは endsAt でも判定する）
model ListingPromotion {
  id          String @id @default(cuid())
  tenantId    String @map("tenant_id")
  offeringId  String @map("offering_id")
  orderItemId String? @unique @map("order_item_id") // 二重付与防止
  effectType  String @map("effect_type") // featured / top_pr / urgent
  status      String @default("scheduled") // pending_review / scheduled / active / expired / rejected / cancelled
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNote  String?   @map("review_note")
  endingNoticeSentAt DateTime? @map("ending_notice_sent_at") // 終了3日前通知の一度きり制御
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([offeringId])
  @@index([status, endsAt])
  @@map("listing_promotions")
}

/// 初回紹介の解放記録。課金単位=売り手会員×探している案件（案件所有者は案件で一意に決まる）
model ContactUnlock {
  id             String @id @default(cuid())
  tenantId       String @map("tenant_id")
  sellerMemberId String @map("seller_member_id") // 提案する側（売り手）
  offeringId     String @map("offering_id") // WANT案件
  seekerMemberId String @map("seeker_member_id") // 案件の掲載者（買い手）
  threadId       String? @map("thread_id")
  messageId      String? @map("message_id") // 初回提案メッセージ
  status         String  @default("unlocked") // unlocked / refunded
  pricingTier    String  @map("pricing_tier") // standard / verified_lead
  creditLedgerEntryId String? @map("credit_ledger_entry_id") // 消費エントリ
  openedAt            DateTime? @map("opened_at") // 相手が初回メッセージを開封した日時
  unreadRefundDueAt   DateTime? @map("unread_refund_due_at") // 送信+14日
  unreadRefundedAt    DateTime? @map("unread_refunded_at") // 未読返還済み（一度きり）
  unlockedAt          DateTime  @default(now()) @map("unlocked_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@unique([sellerMemberId, offeringId])
  @@index([seekerMemberId])
  @@index([unreadRefundDueAt])
  @@map("contact_unlocks")
}

/// 条件一致通知の実行記録（購入→審査→送信。二重送信をorderItemId uniqueで防止）
model MatchedNotice {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  offeringId  String  @map("offering_id")
  orderItemId String? @unique @map("order_item_id")
  status      String  @default("pending_review") // pending_review / sent / rejected
  criteria    String? // 抽出条件のメモ（案件カテゴリ・地域など）
  targetCount Int?    @map("target_count") // 購入時に提示した予定件数
  sentCount   Int?    @map("sent_count") // 実際に送った件数
  reviewNote  String? @map("review_note")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([offeringId])
  @@index([status])
  @@map("matched_notices")
}

/// 紹介クレジット台帳（残高は上書きせず増減理由を追記。正のエントリ=ロット、負のエントリはロットを参照）
model ContactCreditLedger {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  memberId String @map("member_id")
  entryType String @map("entry_type") // purchase / grant / member_monthly / refund / consume / release / expire / admin_adjust
  creditType String @map("credit_type") // standard（通常案件）/ verified（優良案件）
  quantity   Int // 正=付与ロット、負=消費・失効
  lotEntryId String? @map("lot_entry_id") // 負のエントリが消費するロット（正エントリ）のid
  expiresAt  DateTime? @map("expires_at") // ロットの有効期限（null=無期限）
  orderItemId     String? @map("order_item_id")
  contactUnlockId String? @map("contact_unlock_id")
  idempotencyKey  String? @unique @map("idempotency_key") // 二重付与・二重返還防止
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([memberId, creditType])
  @@index([lotEntryId])
  @@map("contact_credit_ledger")
}

model OfferingView {
  id           String   @id @default(cuid())
  offeringId   String   @map("offering_id")
  viewerUserId String?  @map("viewer_user_id") // 閲覧したユーザー（最近閲覧の集計用）
  createdAt    DateTime @default(now()) @map("created_at")

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId, createdAt])
  @@index([viewerUserId, createdAt])
  @@map("offering_views")
}
